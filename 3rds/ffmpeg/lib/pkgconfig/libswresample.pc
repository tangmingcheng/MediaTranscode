prefix=/local64
exec_prefix=${prefix}
libdir=/local64/lib
includedir=/local64/include

Name: libswresample
Description: FFmpeg audio resampling library
Version: 6.4.100
Requires: 
Requires.private: libavutil >= 60.33.101
Conflicts:
