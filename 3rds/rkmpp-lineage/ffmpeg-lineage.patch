+/* Packet properties follow the decoder-owned picture, as in libdav1d.
+ * The payload is already owned by MPP; retaining it again is unnecessary. */
+static void rkmpp_free_packet_props(void *data)
+{
+    AVPacket *props = data;
+    av_packet_free(&props);
+}
+
+static int rkmpp_set_packet_props(MppPacket packet, const AVPacket *pkt)
+{
+    AVPacket *props = av_packet_alloc();
+    MppUserData data = NULL;
+    int ret;
+
+    if (!props)
+        return AVERROR(ENOMEM);
+    if ((ret = av_packet_copy_props(props, pkt)) < 0) {
+        av_packet_free(&props);
+        return ret;
+    }
+    if (mpp_user_data_create(&data, props, rkmpp_free_packet_props) != MPP_OK) {
+        av_packet_free(&props);
+        return AVERROR(ENOMEM);
+    }
+    mpp_packet_set_user_data(packet, data);
+    mpp_user_data_unref(&data);
+    return 0;
+}
