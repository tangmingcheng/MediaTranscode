+/* Local dependency contract: only an opened, queried MPP context can
+ * advertise packet identity. This is not a claim about arbitrary MPP builds. */
+static int rkmpp_read_opaque_contract(AVCodecContext *avctx)
+{
+    RKMPPDecContext *r = avctx->priv_data;
+    MppDecUserDataGeometry facts = { 0 };
+    uint64_t hidden, retained;
+    int ret;
+
+    if (!(avctx->flags & AV_CODEC_FLAG_COPY_OPAQUE))
+        return 0;
+    ret = r->mapi->control(r->mctx, MPP_DEC_QUERY_USER_DATA, &facts);
+    if (ret != MPP_OK || facts.version != 1 || facts.split_parse ||
+        facts.coding != rkmpp_get_coding_type(avctx) ||
+        !facts.frame_slots || !facts.input_tasks || !facts.hal_tasks ||
+        !facts.parser_owner_slots || !facts.user_data_bytes ||
+        facts.user_data_bytes > INT64_MAX)
+        return AVERROR(ENOSYS);
+
+    hidden = (uint64_t)facts.frame_slots + facts.input_tasks + facts.hal_tasks +
+             facts.parser_owner_slots + facts.vproc_owner_slots + facts.context_packet_slots;
+    /* Drain-before-each-feed: an output-empty boundary has at most hidden
+     * distinct owners. One subsequent input can add one token before output
+     * appears; while output is queued there is no further submission. Count
+     * both that output burst and all hidden owners, allowing aliases.
+     * Six extra internal owners: last_pkt, AVCodecInternal in_pkt,
+     * last_pkt_props, buffer_pkt, buffer_frame, and BSF buffer_pkt.
+     * The two mp4toannexb filters retain no additional distinct packet. */
+    if (hidden > (INT64_MAX - 7) / 2)
+        return AVERROR(ERANGE);
+    retained = 2 * hidden + 1 + 6;
+    if (r->opaque_contract_version &&
+        (retained > r->opaque_retained_packets ||
+         facts.user_data_bytes != r->opaque_userdata_bytes))
+        return AVERROR_INVALIDDATA;
+    if (!r->opaque_contract_version) {
+        r->opaque_retained_packets = retained;
+        r->opaque_userdata_bytes = facts.user_data_bytes;
+        r->opaque_packet_props_bytes = sizeof(AVPacket);
+        r->opaque_contract_version = facts.version;
+    }
+    return 0;
+}
