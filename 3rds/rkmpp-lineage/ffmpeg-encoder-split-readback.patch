+/* Read effective state after MPP has accepted a configuration transaction. */
+static int rkmpp_read_split_state(AVCodecContext *avctx)
+{
+    RKMPPEncContext *r = avctx->priv_data;
+    MppEncCfg actual = NULL;
+    RK_U32 mode, arg, out;
+    RK_S32 low_delay;
+    MPP_RET ret;
+
+    r->split_state_known = 0;
+    r->effective_split_mode = r->effective_split_arg = r->effective_split_out = -1;
+    r->effective_low_delay = -1;
+    ret = mpp_enc_cfg_init(&actual);
+    if (ret != MPP_OK)
+        goto done;
+    ret = r->mapi->control(r->mctx, MPP_ENC_GET_CFG, actual);
+    if (ret != MPP_OK)
+        goto done;
+    ret = mpp_enc_cfg_get_u32(actual, "split:mode", &mode);
+    if (ret != MPP_OK)
+        goto done;
+    ret = mpp_enc_cfg_get_u32(actual, "split:arg", &arg);
+    if (ret != MPP_OK)
+        goto done;
+    ret = mpp_enc_cfg_get_u32(actual, "split:out", &out);
+    if (ret != MPP_OK)
+        goto done;
+    ret = mpp_enc_cfg_get_s32(actual, "base:low_delay", &low_delay);
+    if (ret != MPP_OK)
+        goto done;
+    r->effective_split_mode = mode;
+    r->effective_split_arg = arg;
+    r->effective_split_out = out;
+    r->effective_low_delay = low_delay;
+    r->split_state_known = 1;
+done:
+    if (actual)
+        mpp_enc_cfg_deinit(actual);
+    if (ret != MPP_OK) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to read effective encoder split state: %d\n", ret);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
