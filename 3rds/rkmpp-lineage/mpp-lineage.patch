diff --git a/mpp/base/mpp_user_data.c b/mpp/base/mpp_user_data.c
new file mode 100644
index 000000000..7d4b7d0f0
--- /dev/null
+++ b/mpp/base/mpp_user_data.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+#include <stdlib.h>
+#include "mpp_user_data.h"
+struct MppUserDataImpl_t {
+    unsigned int refs;
+    void *data;
+    void (*release)(void *);
+};
+MPP_RET mpp_user_data_create(MppUserData *ref, void *data, void (*release)(void *))
+{
+    MppUserData value;
+    if (!ref || !release)
+        return MPP_ERR_NULL_PTR;
+    *ref = NULL;
+    value = malloc(sizeof(*value));
+    if (!value)
+        return MPP_ERR_MALLOC;
+    value->refs = 1;
+    value->data = data;
+    value->release = release;
+    *ref = value;
+    return MPP_OK;
+}
+void mpp_user_data_ref(MppUserData ref)
+{
+    if (ref)
+        __atomic_add_fetch(&ref->refs, 1, __ATOMIC_RELAXED);
+}
+void mpp_user_data_unref(MppUserData *ref)
+{
+    MppUserData value = ref ? *ref : NULL;
+    if (!value)
+        return;
+    *ref = NULL;
+    if (!__atomic_sub_fetch(&value->refs, 1, __ATOMIC_ACQ_REL)) {
+        value->release(value->data);
+        free(value);
+    }
+}
+void *mpp_user_data_get_data(MppUserData ref)
+{
+    return ref ? ref->data : NULL;
+}
+size_t mpp_user_data_object_size(void)
+{
+    return sizeof(struct MppUserDataImpl_t);
+}
