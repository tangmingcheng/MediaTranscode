 {
     MPP_RET ret = MPP_OK;
+    if (cmd == MPP_DEC_QUERY_USER_DATA) {
+        MppDecUserDataGeometry facts = { 0 };
+        Mpp *mpp = (Mpp *)dec->mpp;
+        RK_S32 slots;
+        if (!param || !mpp || !dec->cfg || !dec->frame_slots)
