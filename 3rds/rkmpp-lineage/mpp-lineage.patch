+/* SPDX-License-Identifier: Apache-2.0 OR MIT */
+#ifndef MPP_DEC_USERDATA_H
+#define MPP_DEC_USERDATA_H
+#include "rk_type.h"
+/* Context geometry, not a bound on an undrained public output queue.
+ * Query under the decoder control serialization after initialization.
+ * The caller must preserve the inspected decode mode. */
+typedef struct MppDecUserDataGeometry_t {
+    RK_U32 version;
+    RK_U32 coding;
+    RK_U32 split_parse;
+    RK_U32 frame_slots;
+    RK_U32 input_tasks;
+    RK_U32 hal_tasks;
+    RK_U32 context_packet_slots;
+    RK_U32 parser_owner_slots;
+    RK_U32 vproc_owner_slots;
+    RK_U64 user_data_bytes;
+} MppDecUserDataGeometry;
+#endif
