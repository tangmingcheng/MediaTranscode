+        if (ret || !facts.parser_owner_slots)
+            return ret ? ret : MPP_ERR_UNKNOW;
+        facts.vproc_owner_slots = dec->enable_deinterlace ?
+            dec_vproc_userdata_owner_slots() : 0;
+        facts.user_data_bytes = mpp_user_data_object_size();
+        if (!facts.user_data_bytes)
+            return MPP_ERR_UNKNOW;
+        facts.version = 1;
+        *(MppDecUserDataGeometry *)param = facts;
+        return MPP_OK;
+    }
+
 
     mpp_parser_control(dec->parser, cmd, param);
 
