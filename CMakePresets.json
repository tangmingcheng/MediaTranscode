{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x86-debug",
            "displayName": "x86 Debug",
            "inherits": "windows-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86-release",
            "displayName": "x86 Release",
            "inherits": "x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-debug-deterministic",
            "displayName": "x64 Debug deterministic tests",
            "inherits": "x64-debug",
            "cacheVariables": {
                "MEDIA_TRANSCODE_BUILD_TESTS": "ON",
                "MEDIA_TRANSCODE_ENABLE_INTEGRATION_TESTS": "OFF",
                "MEDIA_TRANSCODE_ENABLE_HARDWARE_TESTS": "OFF",
                "MEDIA_TRANSCODE_ENABLE_PERFORMANCE_TESTS": "OFF"
            }
        },
        {
            "name": "x64-debug-integration",
            "displayName": "x64 Debug integration tests",
            "inherits": "x64-debug-deterministic",
            "cacheVariables": {
                "MEDIA_TRANSCODE_ENABLE_INTEGRATION_TESTS": "ON"
            }
        },
        {
            "name": "x64-debug-hardware",
            "displayName": "x64 Debug hardware tests",
            "inherits": "x64-debug-deterministic",
            "cacheVariables": {
                "MEDIA_TRANSCODE_ENABLE_HARDWARE_TESTS": "ON"
            }
        },
        {
            "name": "x64-debug-performance",
            "displayName": "x64 Debug performance tests",
            "inherits": "x64-debug-deterministic",
            "cacheVariables": {
                "MEDIA_TRANSCODE_ENABLE_PERFORMANCE_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "deterministic", "configurePreset": "x64-debug-deterministic" },
        { "name": "integration", "configurePreset": "x64-debug-integration" },
        { "name": "hardware", "configurePreset": "x64-debug-hardware" },
        { "name": "performance", "configurePreset": "x64-debug-performance" }
    ],
    "testPresets": [
        {
            "name": "deterministic",
            "configurePreset": "x64-debug-deterministic",
            "filter": { "include": { "label": "deterministic" } },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "integration",
            "configurePreset": "x64-debug-integration",
            "filter": { "include": { "label": "integration" } },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "hardware",
            "configurePreset": "x64-debug-hardware",
            "filter": { "include": { "label": "hardware" } },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "performance",
            "configurePreset": "x64-debug-performance",
            "filter": { "include": { "label": "performance" } },
            "output": { "outputOnFailure": true }
        }
    ]
}
