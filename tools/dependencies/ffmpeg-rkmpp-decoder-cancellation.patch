+/* Keep the backend's existing pending-input wait cadence. This is a
+ * cooperative polling interval, not a media deadline or an EAGAIN escape. */
+#define RKMPP_PENDING_WAIT_MS 100
+
+/* Private ABI v1: H.264/HEVC copied-input decode loops only. This does not
+ * promise interruption of MPP reset/destroy or a kernel/driver call. */
+unsigned avcodec_rkmpp_interrupt_version(AVCodecContext *avctx);
+int avcodec_rkmpp_set_interrupt_callback(AVCodecContext *avctx, unsigned version,
+                                       int (*callback)(void *), void *opaque);
+
+unsigned avcodec_rkmpp_interrupt_version(AVCodecContext *avctx)
+{
+    if (!avctx || !avcodec_is_open(avctx) || !avctx->codec ||
+        !avctx->codec->name || !avctx->priv_data ||
+        (strcmp(avctx->codec->name, "h264_rkmpp") &&
+         strcmp(avctx->codec->name, "hevc_rkmpp")))
+        return 0;
+    return 1;
+}
+
+int avcodec_rkmpp_set_interrupt_callback(AVCodecContext *avctx, unsigned version,
+                                       int (*callback)(void *), void *opaque)
+{
+    RKMPPDecContext *r;
+    MppPollType input_timeout = MPP_POLL_NON_BLOCK;
+    if (version != 1 || avcodec_rkmpp_interrupt_version(avctx) != version)
+        return AVERROR(ENOSYS);
+    if (!callback || !opaque)
+        return AVERROR(EINVAL);
+    r = avctx->priv_data;
+    if (r->decode_started || r->interrupt_callback)
+        return AVERROR(EBUSY);
+    /* The paired MPP EOS-input patch makes the pre-enqueue EOS reservation
+     * obey this same input timeout. No accepted packet is retried here. */
+    if (r->mapi->control(r->mctx, MPP_SET_INPUT_TIMEOUT, &input_timeout) != MPP_OK)
+        return AVERROR_EXTERNAL;
+    r->interrupt_opaque = opaque;
+    r->interrupt_callback = callback;
+    return 0;
+}
+
+static int rkmpp_interrupted(const RKMPPDecContext *r)
+{
+    return r->interrupt_callback && r->interrupt_callback(r->interrupt_opaque);
 }

